            "attendee",
            "admin"
          ],
          "example": "attendee"
        },
        "phone": {
          "type": "string",
          "example": "+256700000000"
        },
        "oauthProvider": {
          "type": "string",
          "enum": [
            "google",
            "github"
          ]
        },
        "oauthId": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "UserUpdate": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Solomon"
